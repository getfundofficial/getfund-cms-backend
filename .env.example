# Server
NODE_ENV=development
PORT=5000

# Frontend URLs (for CORS)
PUBLIC_WEBSITE_URL=http://localhost:5173
ADMIN_DASHBOARD_URL=http://localhost:5174

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=1d
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this-too
JWT_REFRESH_EXPIRE=7d

# Database (Neon PostgreSQL - Cloud)
# Recommended for most uses (with connection pooling via PgBouncer)
DATABASE_URL=postgresql://neondb_owner:your_password@your-host-pooler.aws.neon.tech/neondb?sslmode=require

# For uses requiring a connection without pgbouncer (migrations, etc.)
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:your_password@your-host.aws.neon.tech/neondb?sslmode=require

# Vercel Postgres Template URLs
POSTGRES_URL=postgresql://neondb_owner:your_password@your-host-pooler.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL_NON_POOLING=postgresql://neondb_owner:your_password@your-host.aws.neon.tech/neondb?sslmode=require
POSTGRES_PRISMA_URL=postgresql://neondb_owner:your_password@your-host-pooler.aws.neon.tech/neondb?connect_timeout=15&sslmode=require

# For local development (alternative):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/getfund_cms

# For Supabase (alternative):
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-role-key

# Supabase JWT Secret (for CRM authentication)
# Get this from your Supabase project settings: Settings > API > JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Payment Gateway (Xcel)
XCEL_PUBLIC_KEY=your-xcel-public-key
XCEL_WEBHOOK_SECRET=your-xcel-webhook-secret
NEXT_PUBLIC_WEBSITE_URL=https://getfund-website-hq.vercel.app
NEXT_PUBLIC_BACKEND_URL=https://getfund-cms-backend.vercel.app
